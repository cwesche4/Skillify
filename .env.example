# ---------------------------------------------------------
# DATABASE
# ---------------------------------------------------------
# Required for application runtime and Prisma. Prisma Studio falls back locally
# when this is unset, but deployed environments should always configure it.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/skillify?schema=public"

# ---------------------------------------------------------
# AUTHENTICATION
# ---------------------------------------------------------
# Clerk powers user authentication and workspace access. Public values may be
# exposed to the browser; secret and webhook values must stay server-only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
CLERK_JWT_KEY=""
CLERK_WEBHOOK_SECRET=""
CLERK_SIGN_IN_URL="/sign-in"
CLERK_SIGN_UP_URL="/sign-up"
CLERK_AFTER_SIGN_IN_URL="/dashboard"
CLERK_AFTER_SIGN_UP_URL="/onboarding/create-workspace"

# ---------------------------------------------------------
# NEXT.JS / APP URLS
# ---------------------------------------------------------
# Public URLs are used for links, webhooks, feeds, and emails. VERCEL_URL is
# usually provided by Vercel and should not contain a protocol.
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
APP_BASE_URL="http://localhost:3000"
VERCEL_URL=""
NODE_ENV="development"

# ---------------------------------------------------------
# AI PROVIDERS
# ---------------------------------------------------------
# OpenAI is optional. When OPENAI_API_KEY is unset, the production provider is
# disabled and offline/mock providers continue to support local development.
AI_ACTIONS_GLOBALLY_DISABLED=false
AI_PLAYGROUND_ENABLED=true
OPENAI_API_KEY=""
OPENAI_ORG_ID=""
OPENAI_PROJECT_ID=""
OPENAI_DEFAULT_MODEL="gpt-4.1-mini"
OPENAI_REASONING_MODEL="o4-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_TIMEOUT_MS=30000
OPENAI_MAX_RETRIES=1

# Future AI provider placeholders. These are not used by the current runtime.
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL=""
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION=""

# ---------------------------------------------------------
# CRM INTEGRATIONS
# ---------------------------------------------------------
# HubSpot OAuth settings are validated lazily inside CRM integration paths so
# missing values do not prevent non-CRM pages from loading.
HUBSPOT_CLIENT_ID=""
HUBSPOT_CLIENT_SECRET=""
HUBSPOT_REDIRECT_URI=""
HUBSPOT_API_KEY=""
HUBSPOT_PRIVATE_APP_TOKEN=""
HUBSPOT_PIPELINE_ID=""
HUBSPOT_DEAL_STAGE_ID=""
HUBSPOT_DEAL_STAGE_NEW=""
HUBSPOT_OWNER_ID=""

# CRM integration safety switches. Leave false unless temporarily disabling
# integration traffic during incident response or local testing.
CRM_DISABLE_ALL=false
CRM_DISABLE_INBOUND=false
CRM_DISABLE_ACTIONS=false

# ---------------------------------------------------------
# SCHEDULING
# ---------------------------------------------------------
# Native Scheduling persistence is independent from external calendar sync.
SCHEDULING_PERSISTENCE_ENABLED=true
SCHEDULING_NOTIFICATIONS_ENABLED=false
SCHEDULING_AI_ENABLED=true
SCHEDULING_WORKER_SECRET=""
CRON_SECRET=""

# Scheduling email development mode accepts blank, transient-failure, or
# permanent-failure for local notification testing.
SCHEDULING_EMAIL_DEV_MODE=""
SCHEDULING_EMAIL_FROM=""
SCHEDULING_EMAIL_REPLY_TO=""

# ---------------------------------------------------------
# CALENDAR PROVIDERS
# ---------------------------------------------------------
# External calendar providers are disabled unless explicitly enabled and
# configured. Missing provider credentials should not prevent native Scheduling.
GOOGLE_CALENDAR_SYNC_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI=""
GOOGLE_CALENDAR_WEBHOOK_URL=""
GOOGLE_SERVICE_ACCOUNT=""
GOOGLE_CALENDAR_ID=""

MICROSOFT_CALENDAR_SYNC_ENABLED=false
MICROSOFT_CALENDAR_CLIENT_ID=""
MICROSOFT_CALENDAR_CLIENT_SECRET=""
MICROSOFT_CALENDAR_REDIRECT_URI=""
MICROSOFT_CALENDAR_TENANT_ID="common"
MICROSOFT_CALENDAR_WEBHOOK_URL=""

CALDAV_SYNC_ENABLED=false
CALENDLY_API_KEY=""

SCHEDULING_ICS_ENABLED=true
SCHEDULING_ICS_FEED_SECRET=""

# ---------------------------------------------------------
# NOTIFICATIONS
# ---------------------------------------------------------
# Notification targets are optional. Missing values skip the related delivery
# channel rather than crashing startup.
NOTIFY_EMAIL_TO=""
NOTIFY_SMS_TO=""
UPSELL_NOTIFY_EMAIL=""
SALES_TEAM_EMAIL=""

SLACK_WEBHOOK_URL=""
SLACK_UPSELL_WEBHOOK_URL=""
SLACK_ENTERPRISE_WEBHOOK_URL=""
SLACK_SALES_WEBHOOK_URL=""
SLACK_ALERTS_WEBHOOK_URL=""

# ---------------------------------------------------------
# SMS
# ---------------------------------------------------------
# Legacy platform Twilio variables are optional. The production multi-tenant
# model uses Twilio Connect so each workspace authorizes and pays for its own
# Twilio account.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
TWILIO_CONNECT_ENABLED=false
TWILIO_CONNECT_APP_SID=""
TWILIO_CONNECT_CALLBACK_URL=""
SMS_UPSELL_API_URL=""
SMS_UPSELL_API_KEY=""

# ---------------------------------------------------------
# EMAIL
# ---------------------------------------------------------
# Platform Resend is optional and reserved for Skillify system email such as
# invitations, account/security notices, billing notices, and platform alerts.
# Workspace business email should use encrypted workspace-owned Resend
# connections, not Vercel environment variables.
RESEND_API_KEY=""
EMAIL_FROM="Skillify <no-reply@skillify.tech>"

# ---------------------------------------------------------
# PAYMENTS
# ---------------------------------------------------------
# Stripe is a placeholder for current billing routes and future checkout flows.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_PRICE_BASIC_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
BILLING_DEFAULT_TRIAL_DAYS=14
BILLING_PAYMENT_METHOD_REQUIRED_DURING_TRIAL=true

# ---------------------------------------------------------
# STORAGE / UPLOADS
# ---------------------------------------------------------
# Future storage provider placeholders. Local preview storage does not require
# these values.
STORAGE_PROVIDER=""
UPLOAD_MAX_BYTES=""
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# ---------------------------------------------------------
# WORKFLOW / AUTOMATION SERVICE ACCESS
# ---------------------------------------------------------
# Service tokens are server-only. Use narrow scopes for internal automation and
# background worker calls.
AUTOMATION_DEBUG_MODE=false
AUTOMATION_SERVICE_TOKEN=""
AUTOMATION_SERVICE_SCOPES=""
AUTOMATION_SERVICE_SYSTEM="env-service-token"
INTERNAL_SERVICE_TOKEN=""

# ---------------------------------------------------------
# TESTING
# ---------------------------------------------------------
# Used by Playwright and focused local smoke tests.
PLAYWRIGHT_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------
# MONITORING / LOGGING
# ---------------------------------------------------------
# Future telemetry placeholders. Leave blank unless a provider is configured.
LOG_LEVEL="info"
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ---------------------------------------------------------
# SECURITY
# ---------------------------------------------------------
# Base64-encoded 32-byte keys. Generate with: openssl rand -base64 32
INTEGRATIONS_ENCRYPTION_KEY=""
SECRET_ENCRYPTION_KEY=""
