  @@unique([workspaceId, entitlementKey, effectiveAt])
  @@index([workspaceId, entitlementKey])
  @@index([workspaceId, effectiveAt])
}

/// Append-only entitlement change log (contract-level)
model EntitlementAuditEvent {
  id             String                    @id @default(cuid())
  workspaceId    String
  entitlementKey String
  action         EntitlementAuditAction
  source         EntitlementAuditSource
  actorType      EntitlementAuditActorType
  actorId        String?
  effectiveAt    DateTime
  createdAt      DateTime                  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([workspaceId, entitlementKey, createdAt])
}

/// Service tokens for automation callbacks (hash stored; no user impersonation)
model AutomationServiceToken {
  id        String                   @id @default(cuid())
  tokenHash String                   @unique /// Store hashed token; raw token never persisted.
  scopes    AutomationServiceScope[]
  system    AutomationServiceSystem
  active    Boolean                  @default(true)
  revokedAt DateTime?
  createdAt DateTime                 @default(now())

  @@index([active, system])
}

