  nodeLocks             NodeLock[]
  automationVersions    AutomationVersion[]
  lineage               AutomationLineage?
  forks                 AutomationLineage[]    @relation("AutomationForks")
}

//
// TEMPLATES & PATTERNS — TRUST-FIRST
//

enum TemplateVisibility {
  PUBLIC
  WORKSPACE
  PRIVATE
}

enum PatternVisibility {
  WORKSPACE
  PRIVATE
}

model AutomationTemplate {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String?
  category    String?
  tags        String[]
  visibility  TemplateVisibility @default(PUBLIC)

  // Snapshot of the builder graph. Read-only reference.
  // Must not contain secrets, tokens, or real PII.
  flow        Json
  flowVersion Int  @default(1)

  // Trust-first constraints
  readOnly   Boolean @default(true)
  executable Boolean @default(false)

  // Ownership scope (workspace templates)
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])

  createdById String?
  createdBy   UserProfile? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineages AutomationLineage[]

  @@index([workspaceId])
  @@index([category])
}

model WorkspacePattern {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  name        String
  description String?
  tags        String[]
  visibility  PatternVisibility @default(WORKSPACE)

  // Static snapshot only. No linkage after insertion.
  snapshot        Json
  snapshotVersion Int  @default(1)

  // Helpful metadata for UX (never authoritative)
  nodeCount   Int?
  inputHints  Json?
  outputHints Json?

  createdById String?
  createdBy   UserProfile? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model AutomationLineage {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  automationId String     @unique
  automation   Automation @relation(fields: [automationId], references: [id])

  forkedFromId String?
  forkedFrom   Automation? @relation("AutomationForks", fields: [forkedFromId], references: [id])

  templateId String?
  template   AutomationTemplate? @relation(fields: [templateId], references: [id])

  demoFlowId String?

  forkedById String?
  forkedBy   UserProfile? @relation(fields: [forkedById], references: [id])

  forkedAt DateTime @default(now())

  @@index([workspaceId])
  @@index([forkedFromId])
  @@index([templateId])
}

model AuditEvent {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  objectId    String?
  objectType  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  actor     UserProfile? @relation(fields: [actorId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([action, createdAt])
}

model WorkspaceSecret {
  id          String   @id @default(cuid())
  workspaceId String
  alias       String
  lastFour    String
  createdAt   DateTime @default(now())
  rotatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  versions  SecretVersion[]

  @@index([workspaceId, alias])
}

model SecretVersion {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id])
  secretId    String
  secret      WorkspaceSecret @relation(fields: [secretId], references: [id])
  ciphertext  Bytes
  iv          Bytes
  createdAt   DateTime        @default(now())
  createdById String?
  createdBy   UserProfile?    @relation(fields: [createdById], references: [id])

  @@index([workspaceId, secretId, createdAt])
}

model AutomationRun {
  id           String @id @default(cuid())
  automationId String
  workspaceId  String

  status     RunStatus
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  log        String?

  durationMs Int?

  automation    Automation   @relation(fields: [automationId], references: [id])
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  userProfile   UserProfile? @relation(fields: [userProfileId], references: [id])
  userProfileId String?

  events AutomationRunEvent[]

  @@index([workspaceId])
  @@index([automationId])
}

model AutomationRunEvent {
  id        String    @id @default(cuid())
  runId     String
  nodeId    String
  nodeType  String
  status    RunStatus
  message   String?
  path      String?
  createdAt DateTime  @default(now())

  run AutomationRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@index([nodeId])
  @@index([nodeType])
  @@index([status])
}

//
// BILLING
//

model Subscription {
  id     String      @id @default(cuid())
  userId String      @unique
  user   UserProfile @relation(fields: [userId], references: [id])

  subscriberName  String?
  subscriberEmail String?
  plan            SubscriptionPlan
  status          SubscriptionStatus

  stripeCustomerId String?
  stripeSubId      String?

  trialEndsAt           DateTime?
  complimentaryEndsAt   DateTime?
  paymentMethodRequired Boolean                  @default(true)
  accessSource          SubscriptionAccessSource @default(NORMAL_TRIAL)
  accessCodeId          String?
  accessCode            AccessCode?              @relation(fields: [accessCodeId], references: [id], onDelete: SetNull)
  accessReason          String?

  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  workspaces            Workspace[]
  accessCodeRedemptions AccessCodeRedemption[]

  @@index([accessCodeId])
  @@index([status, trialEndsAt])
  @@index([status, complimentaryEndsAt])
}

model AccessCode {
  id                    String            @id @default(cuid())
  code                  String            @unique
  active                Boolean           @default(true)
  type                  AccessCodeType
  plan                  SubscriptionPlan?
  discountPercent       Int?
  discountAmountCents   Int?
  trialDaysOverride     Int?
  complimentaryDays     Int?
  complimentaryUntil    DateTime?
  paymentMethodRequired Boolean?
  maxUses               Int?
  usesCount             Int               @default(0)
  perUserLimit          Int?
  startsAt              DateTime?
  expiresAt             DateTime?
  internalReason        String?
  notes                 String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  subscriptions Subscription[]
  redemptions   AccessCodeRedemption[]

  @@index([active, type])
  @@index([plan])
  @@index([startsAt, expiresAt])
}

model AccessCodeRedemption {
  id             String   @id @default(cuid())
  accessCodeId   String
  userId         String
  workspaceId    String?
  subscriptionId String?
  redeemedAt     DateTime @default(now())

  accessCode   AccessCode    @relation(fields: [accessCodeId], references: [id], onDelete: Cascade)
  user         UserProfile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@unique([accessCodeId, userId])
  @@index([userId, redeemedAt])
  @@index([workspaceId, redeemedAt])
  @@index([subscriptionId])
}

model DashboardPreference {
  id          String @id @default(cuid())
  userId      String
  workspaceId String

  layout Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      UserProfile @relation(fields: [userId], references: [id])
  workspace Workspace   @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model UpsellRequest {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  userId String
  user   UserProfile @relation(fields: [userId], references: [id])

  automationId String?
  automation   Automation? @relation(fields: [automationId], references: [id])

  description String
  status      String
  type        String
  createdAt   DateTime @default(now())
}

model BuildRequest {
  id          String  @id @default(cuid())
  workspaceId String?
  userId      String?

  name    String
  email   String
  phone   String?
  company String?
  website String?
  size    String?

  projectType     String?
  projectSummary  String
  automationCount Int?
  budgetRange     String?
  timeline        String?

  status    BuildRequestStatus @default(NEW)
  createdAt DateTime           @default(now())
}

model EnterpriseConsultRequest {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  email       String
  phone       String?
  companySize String?
  projectGoal String?
  description String
  status      EnterpriseStatus @default(NEW)
  createdAt   DateTime         @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  user      UserProfile @relation(fields: [userId], references: [id])
}

model TemplatePurchase {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  templateId  String
  price       Int
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  user      UserProfile @relation(fields: [userId], references: [id])
}

model MicroUpsellPurchase {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  feature     String
  price       Int
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  user      UserProfile @relation(fields: [userId], references: [id])
}

/// Connected calendar accounts (Google, Outlook, etc.)
model CalendarAccount {
  id          String           @id @default(cuid())
  userId      String
  workspaceId String
  provider    CalendarProvider
  externalId  String
  email       String
  timezone    String

  credentialRef String?

  connectedAt    DateTime  @default(now())
  disconnectedAt DateTime?

  user      UserProfile @relation(fields: [userId], references: [id])
  workspace Workspace   @relation(fields: [workspaceId], references: [id])

  externalEvents ExternalCalendarEvent[]

  @@index([userId])
  @@index([workspaceId])
  @@index([provider, externalId])
}

/// Event types like "Demo Call", "Strategy Call", "Onboarding", etc.
model BookingType {
  id          String @id @default(cuid())
  workspaceId String
  createdById String

  name        String
  slug        String  @unique
  description String?

  durationMinutes Int
  bufferBefore    Int @default(0)
  bufferAfter     Int @default(0)

  maxPerDay       Int?
  requireApproval Boolean @default(false)
  isActive        Boolean @default(true)
  isPrivate       Boolean @default(false)

  timezone String

  assignedUserId String?
  assignedUser   UserProfile? @relation("BookingTypeAssignedUser", fields: [assignedUserId], references: [id])

  publicPath String?

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  createdBy UserProfile @relation("BookingTypeCreator", fields: [createdById], references: [id])

  availabilityWindows AvailabilityWindow[]
  bookings            Booking[]
  reminderSequences   ReminderSequence[]

  @@index([workspaceId])
  @@index([slug])
  @@index([assignedUserId])
}

/// High-level availability windows (supports weekly + specific-date overrides)
model AvailabilityWindow {
  id            String @id @default(cuid())
  workspaceId   String
  bookingTypeId String

  dayOfWeek    Int?
  dateOverride DateTime?

  startTimeMinutes Int
  endTimeMinutes   Int

  isOverride Boolean @default(false)

  timezone String

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  bookingType BookingType @relation(fields: [bookingTypeId], references: [id])

  @@index([workspaceId])
  @@index([bookingTypeId])
  @@index([dayOfWeek])
  @@index([dateOverride])
}

/// A booking created via Skillify or synced from Calendly / external calendars.
model Booking {
  id            String @id @default(cuid())
  workspaceId   String
  bookingTypeId String

  scheduledForUserId String?
  createdByUserId    String?

  status   BookingStatus     @default(PENDING)
  provider CalendarProvider?

  start DateTime
  end   DateTime

  timezone String

  guestName  String
  guestEmail String
  guestPhone String?

  source          String?
  externalEventId String?
  externalUrl     String?

  answers              Json?
  aiQualificationScore Int?
  aiSummary            String?

  notes String?

  // Reschedule / cancellation
  rescheduleToken RescheduleToken?

  // Relations
  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  bookingType BookingType @relation(fields: [bookingTypeId], references: [id])

  scheduledForUser UserProfile? @relation("BookingScheduledFor", fields: [scheduledForUserId], references: [id])
  createdByUser    UserProfile? @relation("BookingCreatedBy", fields: [createdByUserId], references: [id])

  externalEvents ExternalCalendarEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([bookingTypeId])
  @@index([status])
  @@index([guestEmail])
  @@index([provider, externalEventId])
}

/// Secure reschedule / cancel tokens for guests
model RescheduleToken {
  id        String   @id @default(cuid())
  token     String   @unique
  bookingId String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([token])
}

/// Reminder configuration (per BookingType)
model ReminderSequence {
  id            String @id @default(cuid())
  workspaceId   String
  bookingTypeId String

  offsetMinutes Int

  channel     ReminderChannel
  templateKey String

  isActive Boolean @default(true)

  workspace   Workspace   @relation(fields: [workspaceId], references: [id])
  bookingType BookingType @relation(fields: [bookingTypeId], references: [id])

  @@index([workspaceId])
  @@index([bookingTypeId])
  @@index([channel])
}

/// Mirror of external events (Calendly, Google Calendar, etc.)
model ExternalCalendarEvent {
  id                String           @id @default(cuid())
  workspaceId       String
  calendarAccountId String?
  provider          CalendarProvider

  externalId String
  rawPayload Json
  bookingId  String?

  start DateTime
  end   DateTime
  title String?

  workspace       Workspace        @relation(fields: [workspaceId], references: [id])
  calendarAccount CalendarAccount? @relation(fields: [calendarAccountId], references: [id])
  booking         Booking?         @relation(fields: [bookingId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalId])
  @@index([workspaceId])
  @@index([calendarAccountId])
  @@index([provider, externalId])
}

//
// SCHEDULING PRODUCTION FOUNDATION
//

model SchedulingEvent {
  id           String                @id @default(cuid())
  workspaceId  String
  eventTypeKey String
  title        String
  description  String?
  status       SchedulingEventStatus @default(SCHEDULED)

  startsAtUtc DateTime
  endsAtUtc   DateTime
  timezone    String
  allDay      Boolean  @default(false)

  locationType    SchedulingLocationType?
  locationLabel   String?
  locationAddress String?
  meetingUrl      String?

  recurrenceSeriesId   String?
  recurrenceRule       Json?
  recurrenceTimezone   String?
  occurrenceOriginalAt DateTime?
  occurrenceState      SchedulingOccurrenceState?
  overrideFields       Json?
  recurrenceLineage    Json?
  reminderPolicy       Json?

  linkedRecordType  String?
  linkedRecordId    String?
  linkedRecordLabel String?

  blocksAvailability Boolean                      @default(true)
  externalVisibility SchedulingExternalVisibility @default(DEFAULT)
  syncPolicy         SchedulingSyncPolicy         @default(WORKSPACE_DEFAULT)

  createdByUserId String
  updatedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  canceledAt      DateTime?
  completedAt     DateTime?
  deletedAt       DateTime?

  workspace        Workspace                        @relation(fields: [workspaceId], references: [id])
  recurrenceSeries SchedulingRecurrenceSeries?      @relation("SchedulingEventSeries", fields: [recurrenceSeriesId], references: [id])
  masterSeries     SchedulingRecurrenceSeries?      @relation("SchedulingMasterEvent")
  assignments      SchedulingAssignment[]
  attendees        SchedulingAttendee[]
  providerMappings CalendarEventMapping[]
  syncConflicts    CalendarSyncConflict[]
  notifications    SchedulingNotificationDelivery[]
  activity         SchedulingEventActivity[]

  @@index([workspaceId, startsAtUtc])
  @@index([workspaceId, endsAtUtc])
  @@index([workspaceId, eventTypeKey])
  @@index([workspaceId, status])
  @@index([recurrenceSeriesId])
  @@index([workspaceId, recurrenceSeriesId, occurrenceOriginalAt])
  @@index([workspaceId, occurrenceState])
  @@index([workspaceId, linkedRecordType, linkedRecordId])
}

model SchedulingRecurrenceSeries {
  id                  String                           @id @default(cuid())
  workspaceId         String
  masterEventId       String                           @unique
  timezone            String
  rrule               String
  startsAtLocal       String?
  localStartDate      String?
  localStartTime      String?
  durationMinutes     Int
  normalizedRule      Json?
  untilUtc            DateTime?
  occurrenceCount     Int?
  exdates             Json?
  metadata            Json?
  status              SchedulingRecurrenceSeriesStatus @default(ACTIVE)
  version             Int                              @default(1)
  splitFromSeriesId   String?
  splitAtOccurrenceId String?
  splitBoundaryUtc    DateTime?
  generatedThroughUtc DateTime?
  pausedAt            DateTime?
  canceledAt          DateTime?
  completedAt         DateTime?
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id])
  masterEvent SchedulingEvent   @relation("SchedulingMasterEvent", fields: [masterEventId], references: [id])
  events      SchedulingEvent[] @relation("SchedulingEventSeries")

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([workspaceId, version])
  @@index([workspaceId, splitFromSeriesId])
  @@index([workspaceId, splitBoundaryUtc])
}

model SchedulingRecurrenceMutation {
  id             String    @id @default(cuid())
  workspaceId    String
  seriesId       String?
  idempotencyKey String
  mutationKind   String
  requestHash    String
  status         String
  result         Json?
  errorCode      String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([seriesId, createdAt])
  @@index([workspaceId, mutationKind, createdAt])
}

model SchedulingAssignment {
  id                String                   @id @default(cuid())
  workspaceId       String
  eventId           String
  assignmentType    SchedulingAssignmentType
  workspaceMemberId String?
  teamId            String?
  roleLabel         String?
  displaySnapshot   String?
  notificationState Json?
  createdAt         DateTime                 @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  event     SchedulingEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, workspaceMemberId])
  @@unique([eventId, teamId])
  @@index([workspaceId, workspaceMemberId])
  @@index([workspaceId, teamId])
  @@index([eventId])
}

model SchedulingAttendee {
  id                 String                           @id @default(cuid())
  workspaceId        String
  eventId            String
  attendeeType       SchedulingAttendeeType
  name               String?
  email              String
  responseStatus     SchedulingAttendeeResponseStatus @default(NEEDS_ACTION)
  isOrganizer        Boolean                          @default(false)
  isOptional         Boolean                          @default(false)
  notificationPolicy String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  event     SchedulingEvent @relation(fields: [eventId], references: [id])

  @@unique([eventId, email])
  @@index([workspaceId, email])
  @@index([eventId])
}

model SchedulingAvailabilityRecord {
  id               String                           @id @default(cuid())
  workspaceId      String
  kind             SchedulingAvailabilityRecordKind
  memberId         String?
  teamId           String?
  title            String?
  category         SchedulingTimeOffCategory?
  exceptionType    SchedulingExceptionType?
  startsAtUtc      DateTime?
  endsAtUtc        DateTime?
  timezone         String
  allDay           Boolean                          @default(false)
  daysOfWeek       Int[]                            @default([])
  startTimeMinutes Int?
  endTimeMinutes   Int?
  effectiveFrom    DateTime?
  effectiveUntil   DateTime?
  recurrenceRule   Json?
  notes            String?
  createdByUserId  String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  deletedAt        DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, kind])
  @@index([workspaceId, memberId])
  @@index([workspaceId, teamId])
  @@index([workspaceId, startsAtUtc])
}

model CalendarConnection {
  id                                String                               @id @default(cuid())
  workspaceId                       String
  connectedByUserId                 String
  workspaceMemberId                 String?
  connectedByWorkspaceMemberId      String?
  ownershipType                     CalendarConnectionOwnershipType      @default(MEMBER)
  connectionPurpose                 CalendarConnectionPurpose            @default(UNKNOWN)
  classificationSource              CalendarPurposeClassificationSource  @default(UNKNOWN)
  classificationConfidence          Float?
  classifiedAt                      DateTime?
  classifiedByWorkspaceMemberId     String?
  adminConfirmedAt                  DateTime?
  adminConfirmedByWorkspaceMemberId String?
  availabilityBehavior              PersonalCalendarAvailabilityBehavior @default(IGNORE)
  busyDisplayMode                   PersonalCalendarBusyDisplayMode      @default(HIDDEN)
  visibilityMode                    ExternalCalendarVisibilityMode       @default(BUSY_ONLY)
  approvalStatus                    CalendarConnectionApprovalStatus     @default(APPROVED)
  provider                          CalendarProvider
  providerAccountId                 String
  accountEmail                      String?
  displayName                       String?
  accessTokenEncrypted              String?
  refreshTokenEncrypted             String?
  tokenExpiresAt                    DateTime?
  scopes                            Json?
  syncStatus                        CalendarConnectionStatus             @default(NOT_CONNECTED)
  conflictPolicy                    CalendarConflictPolicy               @default(SKILLIFY_WINS)
  syncFrequencyMinutes              Int                                  @default(15)
  lastSuccessfulSyncAt              DateTime?
  lastAttemptedSyncAt               DateTime?
  lastValidatedAt                   DateTime?
  nextSyncAt                        DateTime?
  lastErrorCode                     String?
  lastErrorMessage                  String?
  oauthState                        String?
  oauthStateExpiresAt               DateTime?
  tokenStatus                       String?
  metadata                          Json?
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt
  disconnectedAt                    DateTime?
  disabledAt                        DateTime?
  disabledReason                    String?
  ownerInactiveAt                   DateTime?

  workspace                  Workspace                @relation(fields: [workspaceId], references: [id])
  workspaceMember            WorkspaceMember?         @relation("CalendarConnectionOwner", fields: [workspaceMemberId], references: [id])
  connectedByWorkspaceMember WorkspaceMember?         @relation("CalendarConnectionConnector", fields: [connectedByWorkspaceMemberId], references: [id])
  calendars                  ConnectedCalendar[]
  syncCursors                CalendarSyncCursor[]
  syncLogs                   CalendarSyncLog[]
  watchChannels              CalendarWatchChannel[]
  diagnostics                CalendarSyncDiagnostic[]
  conflicts                  CalendarSyncConflict[]

  @@unique([workspaceId, provider, providerAccountId])
  @@index([workspaceId, provider])
  @@index([workspaceId, workspaceMemberId])
  @@index([workspaceId, ownershipType])
  @@index([workspaceId, connectionPurpose])
  @@index([connectedByWorkspaceMemberId])
  @@index([syncStatus, nextSyncAt])
}

model ConnectedCalendar {
  id                                String                               @id @default(cuid())
  connectionId                      String
  workspaceId                       String
  providerCalendarId                String
  calendarPurpose                   CalendarConnectionPurpose            @default(UNKNOWN)
  classificationSource              CalendarPurposeClassificationSource  @default(UNKNOWN)
  classificationConfidence          Float?
  classifiedAt                      DateTime?
  classifiedByWorkspaceMemberId     String?
  adminConfirmedAt                  DateTime?
  adminConfirmedByWorkspaceMemberId String?
  availabilityBehavior              PersonalCalendarAvailabilityBehavior @default(IGNORE)
  busyDisplayMode                   PersonalCalendarBusyDisplayMode      @default(HIDDEN)
  name                              String
  ownerEmail                        String?
  description                       String?
  color                             String?
  timezone                          String?
  accessRole                        String?
  visibility                        String?
  isPrimary                         Boolean                              @default(false)
  isWritable                        Boolean                              @default(false)
  selectedForSync                   Boolean                              @default(false)
  importEnabled                     Boolean                              @default(true)
  exportEnabled                     Boolean                              @default(false)
  availabilityEnabled               Boolean                              @default(true)
  defaultExportTarget               Boolean                              @default(false)
  privacyMode                       Boolean                              @default(false)
  syncDirection                     CalendarSyncDirection                @default(IMPORT_ONLY)
  syncFrequencyMinutes              Int?
  lastSyncToken                     String?
  lastSyncedAt                      DateTime?
  nextSyncAt                        DateTime?
  lastErrorCode                     String?
  lastErrorMessage                  String?
  metadata                          Json?
  createdAt                         DateTime                             @default(now())
  updatedAt                         DateTime                             @updatedAt

  workspace     Workspace                @relation(fields: [workspaceId], references: [id])
  connection    CalendarConnection       @relation(fields: [connectionId], references: [id])
  mappings      CalendarEventMapping[]
  syncCursors   CalendarSyncCursor[]
  syncLogs      CalendarSyncLog[]
  watchChannels CalendarWatchChannel[]
  diagnostics   CalendarSyncDiagnostic[]
  conflicts     CalendarSyncConflict[]

  @@unique([connectionId, providerCalendarId])
  @@index([workspaceId])
  @@index([workspaceId, selectedForSync])
  @@index([workspaceId, defaultExportTarget])
  @@index([workspaceId, calendarPurpose])
}

model CalendarSyncCursor {
  id                  String    @id @default(cuid())
  workspaceId         String
  connectionId        String
  connectedCalendarId String?
  cursor              String?
  deltaLink           String?
  pageToken           String?
  expiresAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  connection        CalendarConnection @relation(fields: [connectionId], references: [id])
  connectedCalendar ConnectedCalendar? @relation(fields: [connectedCalendarId], references: [id])

  @@unique([connectionId, connectedCalendarId])
  @@index([workspaceId])
}

model CalendarEventMapping {
  id                       String                 @id @default(cuid())
  workspaceId              String
  schedulingEventId        String?
  recurrenceSeriesId       String?
  occurrenceId             String?
  connectedCalendarId      String
  providerEventId          String
  providerSeriesId         String?
  providerRecurringEventId String?
  providerOccurrenceId     String?
  providerEtag             String?
  providerVersion          String?
  lastSyncOrigin           String?
  originOperation          String?
  syncHash                 String?
  providerUpdatedAt        DateTime?
  syncVersion              Int                    @default(1)
  ownership                CalendarEventOwnership
  syncState                CalendarEventSyncState @default(SYNCED)
  lastSyncedAt             DateTime?
  lastPulledAt             DateTime?
  lastPushedAt             DateTime?
  lastErrorCode            String?
  lastErrorMessage         String?
  deletedAtProvider        Boolean                @default(false)
  deletedAtSkillify        Boolean                @default(false)
  conflictType             String?
  conflictMetadata         Json?
  conflictResolvedAt       DateTime?
  providerSnapshot         Json?
  skillifySnapshot         Json?
  metadata                 Json?

  workspace         Workspace              @relation(fields: [workspaceId], references: [id])
  schedulingEvent   SchedulingEvent?       @relation(fields: [schedulingEventId], references: [id])
  connectedCalendar ConnectedCalendar      @relation(fields: [connectedCalendarId], references: [id])
  conflicts         CalendarSyncConflict[]

  @@unique([connectedCalendarId, providerEventId])
  @@index([workspaceId, schedulingEventId])
  @@index([workspaceId, recurrenceSeriesId])
  @@index([workspaceId, occurrenceId])
  @@index([workspaceId, syncState])
}

model CalendarSyncLog {
  id                  String                   @id @default(cuid())
  workspaceId         String
  connectionId        String?
  connectedCalendarId String?
  schedulingEventId   String?
  direction           CalendarSyncDirectionLog
  operation           String
  status              CalendarSyncLogStatus
  providerCode        String?
  safeMessage         String?
  attempts            Int                      @default(1)
  startedAt           DateTime
  completedAt         DateTime?
  workerId            String?
  durationMs          Int?
  retryable           Boolean?
  metadata            Json?

  workspace         Workspace           @relation(fields: [workspaceId], references: [id])
  connection        CalendarConnection? @relation(fields: [connectionId], references: [id])
  connectedCalendar ConnectedCalendar?  @relation(fields: [connectedCalendarId], references: [id])

  @@index([workspaceId, startedAt])
  @@index([connectionId])
}

model CalendarWatchChannel {
  id                  String                     @id @default(cuid())
  workspaceId         String
  connectionId        String
  connectedCalendarId String?
  provider            CalendarProvider
  providerCalendarId  String?
  channelId           String
  resourceId          String?
  resourceUri         String?
  tokenEncrypted      String?
  status              CalendarWatchChannelStatus @default(ACTIVE)
  expiresAt           DateTime?
  lastMessageNumber   String?
  lastNotificationAt  DateTime?
  failureCode         String?
  failureMessage      String?
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  stoppedAt           DateTime?

  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  connection        CalendarConnection @relation(fields: [connectionId], references: [id])
  connectedCalendar ConnectedCalendar? @relation(fields: [connectedCalendarId], references: [id])

  @@unique([provider, channelId])
  @@index([workspaceId, status, expiresAt])
  @@index([connectionId])
  @@index([connectedCalendarId])
}

model CalendarSyncDiagnostic {
  id                   String   @id @default(cuid())
  workspaceId          String
  connectionId         String?
  connectedCalendarId  String?
  workerKind           String
  status               String
  pendingPull          Int      @default(0)
  pendingPush          Int      @default(0)
  openConflicts        Int      @default(0)
  failedMappings       Int      @default(0)
  activeWatchChannels  Int      @default(0)
  expiredWatchChannels Int      @default(0)
  safeMessage          String?
  metadata             Json?
  measuredAt           DateTime @default(now())

  workspace         Workspace           @relation(fields: [workspaceId], references: [id])
  connection        CalendarConnection? @relation(fields: [connectionId], references: [id])
  connectedCalendar ConnectedCalendar?  @relation(fields: [connectedCalendarId], references: [id])

  @@index([workspaceId, measuredAt])
  @@index([connectionId])
  @@index([connectedCalendarId])
}

model CalendarSyncConflict {
  id                  String                     @id @default(cuid())
  workspaceId         String
  connectionId        String?
  connectedCalendarId String?
  mappingId           String?
  schedulingEventId   String?
  provider            CalendarProvider
  conflictType        String
  status              CalendarSyncConflictStatus @default(OPEN)
  resolutionPolicy    CalendarConflictPolicy     @default(SKILLIFY_WINS)
  resolution          String?
  safeMessage         String
  providerSnapshot    Json?
  skillifySnapshot    Json?
  metadata            Json?
  detectedAt          DateTime                   @default(now())
  resolvedAt          DateTime?
  resolvedByUserId    String?

  workspace         Workspace             @relation(fields: [workspaceId], references: [id])
  connection        CalendarConnection?   @relation(fields: [connectionId], references: [id])
  connectedCalendar ConnectedCalendar?    @relation(fields: [connectedCalendarId], references: [id])
  mapping           CalendarEventMapping? @relation(fields: [mappingId], references: [id])
  schedulingEvent   SchedulingEvent?      @relation(fields: [schedulingEventId], references: [id])

  @@index([workspaceId, status, detectedAt])
  @@index([connectionId])
  @@index([connectedCalendarId])
  @@index([mappingId])
  @@index([schedulingEventId])
}

model SchedulingNotification {
  id                         String                         @id @default(cuid())
  workspaceId                String
  key                        String
  deduplicationKey           String?
  sourceOutboxId             String?
  category                   SchedulingNotificationCategory @default(EVENT_UPDATED)
  priority                   SchedulingNotificationPriority @default(NORMAL)
  recipientType              String?
  recipientUserId            String?
  recipientWorkspaceMemberId String?
  recipientEmail             String?
  title                      String
  body                       String
  deepLink                   String?
  actionUrl                  String?
  entityType                 String?
  entityId                   String?
  schedulingEventId          String?
  occurrenceId               String?
  seriesId                   String?
  relatedRecordType          String?
  relatedRecordId            String?
  metadata                   Json?
  readAt                     DateTime?
  archivedAt                 DateTime?
  createdAt                  DateTime                       @default(now())

  workspace  Workspace                        @relation(fields: [workspaceId], references: [id])
  deliveries SchedulingNotificationDelivery[]

  @@unique([workspaceId, deduplicationKey])
  @@index([workspaceId, recipientUserId, readAt])
  @@index([workspaceId, recipientWorkspaceMemberId, readAt])
  @@index([workspaceId, recipientEmail])
  @@index([workspaceId, category, createdAt])
  @@index([workspaceId, sourceOutboxId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, key])
}

model SchedulingNotificationDelivery {
  id                String                               @id @default(cuid())
  workspaceId       String
  notificationId    String
  schedulingEventId String?
  recipientUserId   String?
  recipientEmail    String?
  channel           SchedulingNotificationChannel
  status            SchedulingNotificationDeliveryStatus @default(PENDING)
  attempts          Int                                  @default(0)
  destination       String?
  provider          String?
  providerMessageId String?
  idempotencyKey    String?
  nextAttemptAt     DateTime?
  claimedAt         DateTime?
  claimedBy         String?
  leaseExpiresAt    DateTime?
  lastAttemptAt     DateTime?
  lastErrorCode     String?
  lastErrorMessage  String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  readAt            DateTime?
  createdAt         DateTime                             @default(now())
  updatedAt         DateTime                             @updatedAt

  workspace       Workspace              @relation(fields: [workspaceId], references: [id])
  notification    SchedulingNotification @relation(fields: [notificationId], references: [id])
  schedulingEvent SchedulingEvent?       @relation(fields: [schedulingEventId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([status, nextAttemptAt])
  @@index([channel, status, nextAttemptAt])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, recipientUserId, readAt])
  @@index([workspaceId, recipientEmail])
  @@index([notificationId])
}

model SchedulingReminderSchedule {
  id                         String                         @id @default(cuid())
  workspaceId                String
  schedulingEventId          String?
  recurrenceSeriesId         String?
  occurrenceId               String?
  occurrenceOriginalAt       DateTime?
  recipientType              String
  recipientUserId            String?
  recipientWorkspaceMemberId String?
  recipientEmail             String?
  channel                    SchedulingNotificationChannel
  category                   SchedulingNotificationCategory @default(REMINDER)
  offsetMinutes              Int?
  scheduledForUtc            DateTime
  eventStartsAtUtc           DateTime?
  timezone                   String
  status                     SchedulingReminderStatus       @default(SCHEDULED)
  idempotencyKey             String
  source                     String
  metadata                   Json?
  claimedAt                  DateTime?
  claimedBy                  String?
  leaseExpiresAt             DateTime?
  attempts                   Int                            @default(0)
  nextAttemptAt              DateTime?
  sentAt                     DateTime?
  canceledAt                 DateTime?
  skippedAt                  DateTime?
  failedAt                   DateTime?
  lastErrorCode              String?
  lastErrorMessage           String?
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, schedulingEventId])
  @@index([workspaceId, recurrenceSeriesId])
  @@index([workspaceId, occurrenceId])
  @@index([status, scheduledForUtc])
  @@index([workspaceId, status, scheduledForUtc])
  @@index([recipientUserId, status, scheduledForUtc])
}

model SchedulingNotificationPreference {
  id                           String   @id @default(cuid())
  workspaceId                  String
  scopeType                    String
  workspaceMemberId            String?
  userId                       String?
  schedulingEnabled            Boolean?
  inAppEnabled                 Boolean?
  emailEnabled                 Boolean?
  categorySettings             Json?
  quietHours                   Json?
  timezone                     String?
  selfNotifications            Boolean?
  defaultReminders             Json?
  externalAttendeesEnabled     Boolean?
  linkedClientsEnabled         Boolean?
  deliveryFailureAlertsEnabled Boolean?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, scopeType, workspaceMemberId])
  @@index([workspaceId, scopeType])
  @@index([workspaceId, userId])
}

model SchedulingEventActivity {
  id          String   @id @default(cuid())
  workspaceId String
  eventId     String
  actorId     String?
  action      String
  source      String
  summary     String
  metadata    Json?
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id])
  event     SchedulingEvent @relation(fields: [eventId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([eventId, createdAt])
}

model DomainOutboxEvent {
  id               String             @id @default(cuid())
  workspaceId      String
  topic            String
  aggregateType    String
  aggregateId      String
  payload          Json
  status           DomainOutboxStatus @default(PENDING)
  attempts         Int                @default(0)
  availableAt      DateTime           @default(now())
  nextAttemptAt    DateTime?
  claimedAt        DateTime?
  claimedBy        String?
  leaseExpiresAt   DateTime?
  processedAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([status, availableAt])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
  @@index([workspaceId, createdAt])
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  authorId String?
  author   UserProfile? @relation(fields: [authorId], references: [id])

  @@index([slug])
  @@index([published])
}

//
// INTEGRATIONS (CRM)
//

model WorkspaceIntegrationConnection {
  id                           String                                  @id @default(cuid())
  workspaceId                  String
  providerId                   String
  category                     String
  ownershipType                WorkspaceIntegrationCredentialOwnership
  status                       WorkspaceIntegrationConnectionStatus    @default(notConnected)
  externalAccountId            String?
  externalAccountLabel         String?
  encryptedCredentials         String?
  credentialHint               String?
  grantedScopes                Json?
  tokenExpiresAt               DateTime?
  refreshStatus                String?
  providerMetadata             Json?
  connectedByUserId            String?
  connectedByWorkspaceMemberId String?
  connectedAt                  DateTime?
  lastValidatedAt              DateTime?
  lastSuccessfulSyncAt         DateTime?
  lastErrorCode                String?
  lastErrorAt                  DateTime?
  disabledAt                   DateTime?
  revokedAt                    DateTime?
  createdAt                    DateTime                                @default(now())
  updatedAt                    DateTime                                @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, providerId, externalAccountId])
  @@index([workspaceId, providerId])
  @@index([workspaceId, status])
  @@index([providerId])
}

model Integration {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  provider String // hubspot | salesforce | pipedrive
  status   IntegrationStatus
  metadata Json?

  credentials  IntegrationCredential[]
  externalRefs ExternalRecord[]

  createdAt DateTime @default(now())

  @@unique([workspaceId, provider])
  @@index([workspaceId])
  @@index([provider])
}

model IntegrationCredential {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id])

  accessToken  String
  refreshToken String?
  expiresAt    DateTime?

  createdAt DateTime @default(now())

  @@index([integrationId])
}

model ExternalRecord {
  id            String       @id @default(cuid())
  workspaceId   String
  workspace     Workspace    @relation(fields: [workspaceId], references: [id])
  integrationId String?
  integration   Integration? @relation(fields: [integrationId], references: [id])

  provider   String // hubspot | salesforce | pipedrive
  objectType String // contact | deal | company
  externalId String

  localType String? // AutomationRun, UpsellRequest, etc.
  localId   String?

  createdAt DateTime @default(now())

  @@unique([workspaceId, provider, objectType, externalId])
  @@index([workspaceId])
  @@index([integrationId])
  @@index([provider, objectType])
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  action      String
  targetType  String
  targetId    String?
  meta        Json?
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id])
  actor     UserProfile? @relation(fields: [actorId], references: [id])

  @@index([workspaceId])
  @@index([action])
}

//
// COLLABORATION (additive, read-only foundations)
//

enum LockState {
  SOFT
  HARD
}

enum LockScope {
  NODE
  CANVAS
}

enum PresenceStatus {
  ACTIVE
  IDLE
  OFFLINE
}

model CollaborationSession {
  id           String   @id @default(cuid())
  workspaceId  String
  automationId String
  userId       String
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @default(now())

  workspace  Workspace       @relation(fields: [workspaceId], references: [id])
  automation Automation      @relation(fields: [automationId], references: [id])
  user       UserProfile     @relation(fields: [userId], references: [id])
  presences  PresenceState[]
  locks      NodeLock[]

  @@index([workspaceId])
  @@index([automationId])
  @@index([userId])
}

model PresenceState {
  id           String         @id @default(cuid())
  sessionId    String
  userId       String
  workspaceId  String
  automationId String
  status       PresenceStatus @default(ACTIVE)
  displayName  String?
  color        String?
  cursorX      Float?
  cursorY      Float?
  viewport     Json?
  activeNodeId String?
  lastSeenAt   DateTime       @default(now())

  session    CollaborationSession @relation(fields: [sessionId], references: [id])
  user       UserProfile          @relation(fields: [userId], references: [id])
  workspace  Workspace            @relation(fields: [workspaceId], references: [id])
  automation Automation           @relation(fields: [automationId], references: [id])

  @@index([workspaceId])
  @@index([automationId])
  @@index([userId])
}

model NodeLock {
  id           String    @id @default(cuid())
  workspaceId  String
  automationId String
  nodeId       String?
  ownerUserId  String
  lockType     LockScope @default(NODE)
  state        LockState @default(SOFT)
  expiresAt    DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  workspace              Workspace             @relation(fields: [workspaceId], references: [id])
  automation             Automation            @relation(fields: [automationId], references: [id])
  owner                  UserProfile           @relation(fields: [ownerUserId], references: [id])
  collaborationSession   CollaborationSession? @relation(fields: [collaborationSessionId], references: [id])
  collaborationSessionId String?

  @@index([workspaceId])
  @@index([automationId])
  @@index([nodeId])
  @@index([ownerUserId])
}

//
// AUTOMATION VERSIONING (foundation only)
//

enum AutomationVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model AutomationVersion {
  id              String                  @id @default(cuid())
  automationId    String
  workspaceId     String
  createdAt       DateTime                @default(now())
  createdByUserId String
  label           String?
  message         String?
  baseVersionId   String?
  status          AutomationVersionStatus @default(DRAFT)

  automation Automation                  @relation(fields: [automationId], references: [id])
  workspace  Workspace                   @relation(fields: [workspaceId], references: [id])
  creator    UserProfile                 @relation(fields: [createdByUserId], references: [id])
  snapshots  AutomationVersionSnapshot[]

  @@index([automationId])
  @@index([workspaceId])
  @@index([createdByUserId])
}

model AutomationVersionSnapshot {
  id            String   @id @default(cuid())
  versionId     String
  flowJson      Json
  schemaVersion Int      @default(1)
  nodeCount     Int      @default(0)
  edgeCount     Int      @default(0)
  checksum      String
  createdAt     DateTime @default(now())

  version AutomationVersion @relation(fields: [versionId], references: [id])

  @@index([versionId])
}

model InspectorTelemetryEvent {
  id           String   @id @default(cuid())
  workspaceId  String?
  automationId String?
  nodeType     String?
  event        String
  payload      Json
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([event])
}

model InspectorPreset {
  id            String   @id @default(cuid())
  workspaceId   String
  nodeType      String
  name          String
  data          Json
  latestVersion Int      @default(1)
  isTemplate    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace                @relation(fields: [workspaceId], references: [id])
  versions  InspectorPresetVersion[]
  shares    InspectorPresetShare[]

  @@unique([workspaceId, nodeType, name])
  @@index([workspaceId, nodeType])
}

model InspectorPresetVersion {
  id        String   @id @default(cuid())
  presetId  String
  version   Int
  data      Json
  createdAt DateTime @default(now())

  preset InspectorPreset @relation(fields: [presetId], references: [id])

  @@unique([presetId, version])
  @@index([presetId])
}

model InspectorPresetShare {
  id                String   @id @default(cuid())
  presetId          String
  sourceWorkspaceId String
  targetWorkspaceId String
  createdAt         DateTime @default(now())

  preset InspectorPreset @relation(fields: [presetId], references: [id])

  @@unique([presetId, targetWorkspaceId])
  @@index([targetWorkspaceId])
  @@index([sourceWorkspaceId])
}
