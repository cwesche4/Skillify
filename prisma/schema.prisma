/// Request record (created once; never updated)
model SecurityPackRequest {
  id                 String                     @id @default(cuid())
  workspaceId        String // scalar only (avoid cascade deletes)
  requestedByUserId  String // scalar only
  industry           SecurityPackIndustry       @default(UNKNOWN)
  reviewType         SecurityPackReviewType
  requestedArtifacts SecurityPackArtifactType[] // what they asked for

  templateFile String? // set by automation; but we do NOT update this here (log it as an event instead)
  bundles      Json? // names + flags only (log as event instead of updating)
  links        Json? // trust URLs only (log as event instead of updating)

  approvalRequired Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
}

/// Append-only event log (SOC-2 friendly)
model SecurityPackAuditEvent {
  id            String                @id @default(cuid())
  requestId     String
  workspaceId   String // scalar only
  eventType     SecurityPackEventType
  correlationId String? // optional cross-system trace (e.g., n8n run)

  // Optional “who”
  actorUserId String? // internal actor (initiator/approver)
  actorRole   SecurityPackApproverRole?

  // Optional “what” (no PII, no payloads)
  templateFile String?
  bundles      Json? // names + flags only
  links        Json? // trust center URLs only

  // Optional decision / delivery metadata
  decisionNotes    String?
  deliveryMethod   SecurityPackDeliveryMethod?
  automationSystem SecurityPackAutomationSystem?
  sent             Boolean? // metadata only

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([requestId, createdAt])
  @@index([workspaceId, eventType, createdAt])
  @@index([correlationId])
}

/// Current contract entitlements (effective state; no pricing)
model ContractEntitlement {
  id             String                 @id @default(cuid())
  workspaceId    String
  entitlementKey String
  source         EntitlementAuditSource @default(CONTRACT)
  effectiveAt    DateTime
  expiresAt      DateTime?
  createdAt      DateTime               @default(now())

