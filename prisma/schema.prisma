  @@unique([workspaceId, entitlementKey, effectiveAt])
  @@index([workspaceId, entitlementKey])
  @@index([workspaceId, effectiveAt])
}

/// Time-bound exceptions (optional additive entitlements)
model ContractException {
  id             String                 @id @default(cuid())
  workspaceId    String
  entitlementKey String
  source         EntitlementAuditSource @default(EXCEPTION)
  effectiveAt    DateTime
  expiresAt      DateTime?
  createdAt      DateTime               @default(now())

