//
// CORE USER
//

model UserProfile {
  id       String          @id @default(cuid())
  clerkId  String          @unique
  fullName String?
  email    String?
  role     UserProfileRole @default(user)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  onboardingProgress OnboardingProgress?

  automations               Automation[]
  runs                      AutomationRun[]
  subscription              Subscription?
  memberships               WorkspaceMember[]
  ownedWorkspaces           Workspace[]                @relation("WorkspaceOwner")
  dashboardPreferences      DashboardPreference[]
  upsellRequests            UpsellRequest[]
  enterpriseConsultRequests EnterpriseConsultRequest[]
  templatePurchases         TemplatePurchase[]
  microUpsellPurchases      MicroUpsellPurchase[]
  blogPosts                 BlogPost[]
  automationTemplates       AutomationTemplate[]
  workspacePatterns         WorkspacePattern[]
  automationLineagesForked  AutomationLineage[]
  auditEvents               AuditEvent[]
  secretVersions            SecretVersion[]
  accessCodeRedemptions     AccessCodeRedemption[]

  // Scheduling relations
  calendarAccounts      CalendarAccount[]
  bookingTypesCreated   BookingType[]          @relation("BookingTypeCreator")
  bookingTypesAssigned  BookingType[]          @relation("BookingTypeAssignedUser")
  bookingsScheduledFor  Booking[]              @relation("BookingScheduledFor")
  bookingsCreated       Booking[]              @relation("BookingCreatedBy")
  auditLogs             AuditLog[]
  aiActionAudits        AiActionAudit[]
  collaborationSessions CollaborationSession[]
  presenceStates        PresenceState[]
  nodeLocks             NodeLock[]
  automationVersions    AutomationVersion[]

  @@index([clerkId])
}

model OnboardingProgress {
  id        String   @id @default(cuid())
  userId    String   @unique
  steps     String[]
  completed Boolean  @default(false)
  updatedAt DateTime @updatedAt

  user UserProfile @relation(fields: [userId], references: [id])
}

//
// WORKSPACES
//

model Workspace {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  businessName String?
  industry     String?

  ownerId String
  owner   UserProfile @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  businessModel          WorkspaceBusinessModel    @default(DIRECT_SALES)
  opportunitiesEnabled   Boolean                   @default(false)
  commerceEnabled        Boolean                   @default(false)
  defaultLeadDestination LeadConversionDestination @default(SALE)
  allowDirectLeadToSale  Boolean                   @default(true)
  qualifiedLeadBehavior  QualifiedLeadBehavior     @default(ASK)
  customerSingularLabel  String                    @default("Client")
  customerPluralLabel    String                    @default("Clients")
  salesLabel             String                    @default("Sales")

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  members                           WorkspaceMember[]
  workspaceTeams                    WorkspaceTeam[]
  workspaceLocations                WorkspaceLocation[]
  automations                       Automation[]
  invites                           WorkspaceInvite[]
  subscription                      Subscription?                       @relation(fields: [subscriptionId], references: [id])
  subscriptionId                    String?
  automationRuns                    AutomationRun[]
  dashboardPreferences              DashboardPreference[]
  upsellRequests                    UpsellRequest[]
  enterpriseConsultRequests         EnterpriseConsultRequest[]
  templatePurchases                 TemplatePurchase[]
  microUpsellPurchases              MicroUpsellPurchase[]
  calendarAccounts                  CalendarAccount[]
  schedulingEvents                  SchedulingEvent[]
  schedulingRecurrenceSeries        SchedulingRecurrenceSeries[]
  schedulingAssignments             SchedulingAssignment[]
  schedulingAttendees               SchedulingAttendee[]
  schedulingAvailabilityRecords     SchedulingAvailabilityRecord[]
  calendarConnections               CalendarConnection[]
  connectedCalendars                ConnectedCalendar[]
  calendarEventMappings             CalendarEventMapping[]
  calendarSyncCursors               CalendarSyncCursor[]
  calendarSyncLogs                  CalendarSyncLog[]
  calendarWatchChannels             CalendarWatchChannel[]
  calendarSyncDiagnostics           CalendarSyncDiagnostic[]
  calendarSyncConflicts             CalendarSyncConflict[]
  schedulingNotifications           SchedulingNotification[]
  schedulingNotificationDeliveries  SchedulingNotificationDelivery[]
  schedulingReminderSchedules       SchedulingReminderSchedule[]
  schedulingNotificationPreferences SchedulingNotificationPreference[]
  schedulingEventActivities         SchedulingEventActivity[]
  revenueTransactions               RevenueTransaction[]
  accessCodeRedemptions             AccessCodeRedemption[]
  domainOutboxEvents                DomainOutboxEvent[]
  bookingTypes                      BookingType[]
  availabilityWindows               AvailabilityWindow[]
  bookings                          Booking[]
  reminderSequences                 ReminderSequence[]
  externalCalendarEvents            ExternalCalendarEvent[]
  integrations                      Integration[]
  integrationConnections            WorkspaceIntegrationConnection[]
  externalRecords                   ExternalRecord[]
  auditLogs                         AuditLog[]
  defaults                          WorkspaceDefaults?
  contractEntitlements              ContractEntitlement[]
  contractExceptions                ContractException[]
  entitlementAuditEvents            EntitlementAuditEvent[]
  automationTemplates               AutomationTemplate[]
  workspacePatterns                 WorkspacePattern[]
  automationLineages                AutomationLineage[]
  auditEvents                       AuditEvent[]
  secrets                           WorkspaceSecret[]
  secretVersions                    SecretVersion[]
  inspectorTelemetryEvents          InspectorTelemetryEvent[]
  settings                          WorkspaceSettings?
  aiProfile                         WorkspaceAIProfile?
  aiActivities                      WorkspaceAIActivity[]
  knowledgeSources                  WorkspaceKnowledgeSource[]
  knowledgeItems                    WorkspaceKnowledgeItem[]
  knowledgeRevisions                WorkspaceKnowledgeRevision[]
  knowledgeApprovals                WorkspaceKnowledgeApproval[]
  knowledgeGaps                     WorkspaceKnowledgeGap[]
  knowledgeCorrections              WorkspaceKnowledgeCorrection[]
  recommendationOutcomes            WorkspaceRecommendationOutcome[]
  confidenceAssessments             WorkspaceConfidenceAssessment[]
  knowledgeLearningEvents           WorkspaceLearningEvent[]
  operationalInsights               OperationalInsight[]
  operationalFindings               OperationalFinding[]
  operationalTrends                 OperationalTrend[]
  operationalRecommendationHistory  OperationalRecommendationHistory[]
  operationalRecommendationOutcomes OperationalRecommendationOutcome[]
  operationalHealthSnapshots        OperationalHealthSnapshot[]
  operationalSignals                OperationalSignal[]
  operationalEvidence               OperationalEvidence[]
  operationalExplanations           OperationalExplanation[]
  operationalDecisions              OperationalDecision[]
  operationalPatterns               OperationalPattern[]
  operationalRisks                  OperationalRisk[]
  operationalResolutions            OperationalResolution[]
  operationalMetricHistory          OperationalMetricHistory[]
  operationalKnowledgeUsage         OperationalKnowledgeUsage[]
  operationalKnowledgeEffectiveness OperationalKnowledgeEffectiveness[]
  operationalDashboardSignals       OperationalDashboardSignal[]
  operationalInsightRevisions       OperationalInsightRevision[]
  operationalInsightAudits          OperationalInsightAudit[]
  aiActionAudits                    AiActionAudit[]
  collaborationSessions             CollaborationSession[]
  presenceStates                    PresenceState[]
  nodeLocks                         NodeLock[]
  automationVersions                AutomationVersion[]
  inspectorPresets                  InspectorPreset[]
  schedulingRecurrenceMutations     SchedulingRecurrenceMutation[]

  @@index([ownerId])
  @@index([slug])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  userId      String
  workspaceId String
  role        WorkspaceMemberRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                         UserProfile           @relation(fields: [userId], references: [id])
  workspace                    Workspace             @relation(fields: [workspaceId], references: [id])
  teamMemberships              WorkspaceTeamMember[]
  ownedCalendarConnections     CalendarConnection[]  @relation("CalendarConnectionOwner")
  connectedCalendarConnections CalendarConnection[]  @relation("CalendarConnectionConnector")

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model WorkspaceTeam {
  id           String             @id @default(cuid())
  workspaceId  String
  name         String
  description  String?
  teamType     WorkspaceTeamType?
  leadMemberId String?
  isActive     Boolean            @default(true)
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  archivedAt   DateTime?

  workspace Workspace             @relation(fields: [workspaceId], references: [id])
  members   WorkspaceTeamMember[]

  @@index([workspaceId, isActive])
  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
}

model WorkspaceTeamMember {
  id                String   @id @default(cuid())
  workspaceId       String
  teamId            String
  workspaceMemberId String
  roleLabel         String?
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())

  team            WorkspaceTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, workspaceMemberId])
  @@index([workspaceId, workspaceMemberId])
  @@index([workspaceId, teamId])
}

model WorkspaceLocation {
  id           String                @id @default(cuid())
  workspaceId  String
  name         String
  locationType WorkspaceLocationType
  addressLine1 String?
  addressLine2 String?
  city         String?
  region       String?
  postalCode   String?
  countryCode  String?
  timezone     String?
  phone        String?
  notes        String?
  isPrimary    Boolean               @default(false)
  isActive     Boolean               @default(true)
  createdById  String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  archivedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, isActive])
  @@index([workspaceId, name])
  @@index([workspaceId, archivedAt])
  @@index([workspaceId, isPrimary])
}

model WorkspaceInvite {
  id          String              @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceMemberRole @default(MEMBER)

  token      String    @unique
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId])
  @@index([email])
}

model WorkspaceSettings {
  id               String   @id @default(cuid())
  workspaceId      String   @unique
  aiActionsEnabled Boolean  @default(false)
  scheduling       Json?
  schedulingEvents Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id])
}

model RevenueTransaction {
  id                         String                       @id @default(cuid())
  workspaceId                String
  clientId                   String?
  customerId                 String?
  amountCents                Int
  currency                   String                       @default("USD")
  occurredAt                 DateTime
  description                String
  sourceType                 RevenueTransactionSourceType @default(MANUAL)
  sourceId                   String?
  status                     RevenueTransactionStatus     @default(ACTIVE)
  createdByUserId            String?
  createdByWorkspaceMemberId String?
  voidedAt                   DateTime?
  voidedByUserId             String?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, clientId])
  @@index([workspaceId, customerId])
  @@index([workspaceId, sourceType, sourceId])
  @@index([workspaceId, status])
}

model WorkspaceAIProfile {
  id                   String            @id @default(cuid())
  workspaceId          String            @unique
  enabled              Boolean           @default(false)
  status               WorkspaceAIStatus @default(NOT_CONFIGURED)
  businessSummary      String?
  productsAndServices  Json?
  operatingGuidelines  Json?
  brandVoice           Json?
  customerPolicies     Json?
  automationGuardrails Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model WorkspaceAIActivity {
  id          String                  @id @default(cuid())
  workspaceId String
  userId      String?
  type        WorkspaceAIActivityType
  source      String?
  metadata    Json?
  createdAt   DateTime                @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, type, createdAt])
  @@index([userId, createdAt])
}

model WorkspaceKnowledgeSource {
  id                     String   @id @default(cuid())
  workspaceId            String
  type                   String
  label                  String
  domain                 String
  actorUserId            String?
  actorWorkspaceMemberId String?
  confidence             String?
  recordType             String?
  recordId               String?
  referenceId            String?
  metadata               Json?
  inspectedAt            DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  workspace      Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  knowledgeItems WorkspaceKnowledgeItem[]

  @@index([workspaceId, type])
  @@index([workspaceId, domain])
  @@index([workspaceId, recordType, recordId])
  @@index([workspaceId, inspectedAt])
}

model WorkspaceKnowledgeItem {
  id              String                           @id @default(cuid())
  workspaceId     String
  sourceId        String?
  category        String
  title           String
  description     String?
  structuredValue Json
  sourceSummary   String?
  confidence      String
  approvalStatus  WorkspaceKnowledgeApprovalStatus @default(DRAFT)
  createdById     String
  approvedById    String?
  approvedAt      DateTime?
  version         Int                              @default(1)
  isArchived      Boolean                          @default(false)
  supersededById  String?
  reason          String?
  tags            String[]
  visibility      WorkspaceKnowledgeVisibility     @default(WORKSPACE)
  status          WorkspaceKnowledgeItemStatus     @default(ACTIVE)
  createdAt       DateTime                         @default(now())
  updatedAt       DateTime                         @updatedAt

  workspace      Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  source         WorkspaceKnowledgeSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  supersededBy   WorkspaceKnowledgeItem?        @relation("WorkspaceKnowledgeSupersession", fields: [supersededById], references: [id])
  supersedes     WorkspaceKnowledgeItem[]       @relation("WorkspaceKnowledgeSupersession")
  revisions      WorkspaceKnowledgeRevision[]
